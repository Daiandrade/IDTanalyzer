# Streamlit Secrets - Example file
# Copy this to secrets.toml and update with real values
# NEVER commit secrets.toml to git!

# Authentication cookie key (generate a random string)
[cookie]
key = "your_secret_cookie_key_here_change_in_production"

# Optional: Database connection (if using external DB instead of SQLite)
# [database]
# host = "your-database-host"
# port = 5432
# database = "idt_analyzer"
# username = "db_user"
# password = "db_password"
